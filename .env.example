# Copy to .env (gitignored) and fill in. Read by scripts/release-local.sh.

# Signing and notarization
APPLE_TEAM_ID=
APPLE_ID=
# App-specific password from https://appleid.apple.com (not your Apple ID password)
APPLE_APP_SPECIFIC_PASSWORD=

# Where the release zip is downloaded from. Each appcast item points at
# ${DOWNLOAD_BASE_URL}/v<version>/wormhole.zip, which matches GitHub Releases.
DOWNLOAD_BASE_URL=https://github.com/jamesrisberg/wormhole/releases/download

# Where the appcast is served. Must equal SUFeedURL in wormhole/Info.plist.
APPCAST_URL=https://viawormhole.xyz/appcast.xml

# Optional: local folder of the site that serves APPCAST_URL. When set, the
# script copies releases/appcast.xml into it.
SITE_DIR=

# Optional: explicit path to Sparkle's sign_update if auto-discovery fails.
# SPARKLE_SIGN_UPDATE=
